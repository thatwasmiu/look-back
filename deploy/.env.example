# Copy to deploy/.env (never commit it). Single quotes keep `$` in the hash literal.
POSTGRES_USER=scrapbook
POSTGRES_PASSWORD=change-me
# same user/password as POSTGRES_*
DATABASE_URL=postgres://scrapbook:change-me@db:5432/scrapbook

# npm run hash-password -w server -- 'your password'
OWNER_PASSWORD_HASH='scrypt$<saltHex>$<hashHex>'
# openssl rand -hex 32   (>= 32 random bytes)
SESSION_SECRET=

MEDIA_DIR=/data/media
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_BYTES=4294967296
# 720 or 720,1080
VIDEO_RENDITIONS=720
FFMPEG_PRESET=veryfast
COOKIE_SECURE=true
# api sits behind nginx
TRUST_PROXY=true
PORT=3000

# Optional: automatic backup to Google Drive (see docs/google-drive-backup.md)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# AI album (Gemini): nothing here — paste the API key in /manage → AI (Gemini).
